# ───────── Клиент (попадают в браузер — это НЕ секреты) ─────────
# Firebase Console → Project settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
# UID супер-овнера (не секрет; только скрывает пункт меню и страницу /super).
# Реальная защита — проверка токена на сервере + Firestore Rules.
NEXT_PUBLIC_SUPER_OWNER_UID=

# ───────── Сервер (ТОЛЬКО в Vercel Environment Variables, без NEXT_PUBLIC_) ─────────
# Тот же UID, что и выше: его токен принимают /api/set-owner.
SUPER_OWNER_UID=
# Длинная случайная строка (32+ символа). Вводится вручную на /super, нигде не хранится в коде.
#   openssl rand -base64 32
OWNER_SECRET=
# Ключ сервисного аккаунта Firebase (JSON) в base64:
#   macOS:  base64 -i key.json | tr -d '\n'
#   Linux:  base64 -w0 key.json
FIREBASE_SA_B64=
